<Project Sdk="Microsoft.NET.Sdk">

	<!-- Import tModLoader mod properties -->
	<Import Project="..\tModLoader.targets" />

	<!-- General -->
	<PropertyGroup>
	<DotNetName Condition=" '$(OS)' == 'Unix' ">/usr/bin/dotnet</DotNetName>
	</PropertyGroup>

	<!-- References -->
	<ItemGroup>
	  <Folder Include="Systems\Player\" />
	</ItemGroup>

	<!-- Unported 1.3-era assets: kept for reference/art, excluded from compilation
	     (build.txt's buildIgnore excludes them from the in-game tModLoader build) -->
	<ItemGroup>
		<Compile Remove="Projectiles\Enemy\UnusedAssets\**" />
		<!-- Standalone developer-data tools have their own projects and are not mod content. -->
		<Compile Remove="Scripts\GenerateDevData\**\*.cs" />
		<!-- Offline preview harnesses (Documentation\tools\SwingPreview) are standalone projects.
		     Their own obj\ output defines assembly attributes, so globbing them into the mod build
		     fails it with CS0579 duplicate-attribute errors rather than anything self-explanatory. -->
		<Compile Remove="Documentation\**\*.cs" />
	</ItemGroup>

</Project>
