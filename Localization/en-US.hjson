		BossChecklist: {
			LeonhardDesc: Explore the suspension bridge between snow-topped mountains.
			VesselOfSoulsDesc: The Vessel of Souls occupies the Eye of Cthulhu's arena.
			PinwheelDesc: Seek the Path of the Drowned under the village entrance.
			AncientOolacileDemonDesc: Legends mention the Oolacile Forest...
			SlograAndGaibonName: Slogra and Gaibon
			SlograAndGaibonDesc: Found in the depths of the Meteor Temple.
			GravelordNitoDesc: A lord of the grave stirs beneath the dungeon.
			JungleWyvernDesc: Found in the depths of the Forgotten City.
			AncientDemonDesc: A secret lair in hell awaits you...
			TheRageDesc: Found in the depths of the Hallowed Caverns.
			TheSorrowDesc: Found in the depths of the Frozen Ocean.
			WyvernMageDesc: Found high atop a mountain in a great fortress.
			TheHunterDesc: Found deep below the Desert Ruins.
			SerrisName: Serris
			SerrisDesc: ???
			DeathDesc: ???
			AttraidiesName: Attraidies
			AttraidiesDesc: Gather all the Crests in order to craft the Mind Cube.
			RealAttraidiesName: Attraidies (Real)
			RealAttraidiesDesc: Use the Mindflayer Illusion Relic dropped by Attraidies' illusion.
			HellkiteDragonDesc: Often sighted roaming the skies above the Village, searching for its next feast.
			OptionalMysteryDesc: Some mysteries can only be discovered through exploration.
			WaterFiendKrakenDesc:
				'''
				Seek out the lihzahrd gate in the Great Chasm.
				Remix Map: Seek out the lihzahrd gate in the Mycelium Forest.
				'''
			EarthFiendLichDesc:
				'''
				Find the ancient Temple west side of the Ashen Cave.
				Remix Map: Seek out the lihzahrd gate in the Great Chasm.
				'''
			WitchkingDesc:
				'''
				Found in his lair deep underground, shrouded in extreme darkness.
				Remix Map: Find the ancient ship hidden in the Shadow Temple.
				'''
			ArtoriasDesc:
				'''
				The Abyss pervades the tunnels east of the Forgotten City.
				Remix Map: Find the forgotten path to Artorias in the Great Foundry somewhere in the Jungle.
				'''
			SeathTheScalelessDesc: Seek out the lihzahrd gate below the Eastern Ocean.
			AbysmalOolacileSorcererDesc:
				'''
				Seek out the lihzahrd gate below the Lihzahrd Temple.
				Remix Map: Seek out the lihzahrd gate below the Eastern Ocean.
				'''
			FireFiendMarilithDesc:
				'''
				Seek out the lihzahrd gate in the Western Desert.
				Remix Map: Find the ancient ship hidden in the Fire Temple.
				'''
			BlightName: Blight
			BlightDesc: The fissure on the Frozen Ocean churns with the energy of the abyss.
			WyvernMageShadowDesc: Find the Glass Prison, high above the fortress on the mountain.
			ChaosDesc:
				'''
				Seek the Moon Temple Gate, to the East of the Great Pryamid.
				Remix Map: Seek the Hallow once more, in the palladium caves.
				'''
			DarkCloudName: ???
			DarkCloudDesc:
				'''
				The ancient pyramid grows dark once more.
				Remix Map: Use the Dark Mirror.
				'''
			SoulOfCinderName: Soul of Cinder
			SoulOfCinderDesc: A fading champion waits beyond Dark Cloud's shadow. In sandbox worlds, use the Soul of Cinder spawner.
			GwynName: Gwyn, Lord of Cinder
			GwynDesc: Seek the tomb below the Western Ocean.
		}

		Items: {
			VanillaItems: {
				LockedCrates: "[c/383838:Cursed] by a ferocious [c/009400:Hunter]"
				ObsidianSkinPotion: "{$CommonItemTooltip.Limited}"
				SuspiciousLookingEye:
					'''
					Item is not consumed so that you can retry the fight on defeat
					The Eye of Cthulhu can only be summoned during the night
					A silver watch may aid in the passing of time...
					'''
				PirateMap:
					'''
					Item is not consumed so that you can retry the fight on defeat
					The Eye of Cthulhu can only be summoned during the night
					A silver watch may aid in the passing of time...
					'''

				MechanicalEye: {
					Tooltip:
						'''
						Summons The Triad
						{$CommonItemTooltip.NonConsumable}
						'''
					OnUseText1: The Triad has spotted you
					OnUseText2: The Triad already has you in their sights...
					OnUseText3: The Triad only awakens at night...
				}

				WaterWalkingBoots: Also provides the ability to temporarily walk on lava
				ChlorophyteMaskSet:
					'''
					Summons a powerful leaf crystal to shoot at nearby enemies
					{$CommonItemTooltip.DRStat}
					'''
				TurtleSet:
					'''
					Attackers also take double damage
					{$CommonItemTooltip.DRStat}
					'''
				FrozenTurtleShell:
					'''
					{$CommonItemTooltip.LifeThreshold}Puts a shell around the owner
					{$CommonItemTooltip.DRStat@1} while the shell is active
					'''
				SharpeningStation: "{$CommonItemTooltip.Melee.ArmorPenPercent}"
				GoldenGi: "{$CommonItemTooltip.Melee.FlatDmg}"
				ManaCost1: "Requires "
				ManaCost2: " mana to cast projectile"
				AmmoReservationPotion: "{$CommonItemTooltip.Ranged.CritDmg}"
				TitanPotion: "{$CommonItemTooltip.Melee.Size}"
				AmmoBox: Increases critical strike chance by your ammo's base damage
				HerosShirt:
					'''
					{$CommonItemTooltip.SetBonus}{$CommonItemTooltip.MaxStamina@1}
					{$CommonItemTooltip.StaminaRegen@2}
					{$CommonItemTooltip.PercentIncreasedCritChance}
					'''
				NinjaHood: "{$CommonItemTooltip.PercentIncreasedCritChance} to melee and ranged"
				NinjaShirt: "{$CommonItemTooltip.PercentIncreasedDamage} to melee and ranged"
				NinjaPants:
					'''
					{$CommonItemTooltip.PercentIncreasedMovementSpeed}
					{$CommonItemTooltip.SetBonus}{$CommonItemTooltip.MaxStamina@1}
					{$CommonItemTooltip.StaminaRegen@2}
					'''
				RedClothRobe:
					'''
					{$CommonItemTooltip.IncreasesMaxManaBy}
					{$CommonItemTooltip.PercentReducedManaCost@1}
					'''
				MagicSummonHybridDamageClass: magic/summon damage
				AleSake: Minor improvements to whip stats
				Firecracker: Explosion increases the damage dealt by {0}%
				MorningStar:
					'''
					{$CommonItemTooltip.SummonTagDamage}
					{$CommonItemTooltip.PercentSummonTagCritChance@1}
					'''
				Kaleidoscope:
					'''
					{$CommonItemTooltip.SummonTagDamage}
					{$CommonItemTooltip.PercentSummonTagCritChance@1}
					'''
				TerraprismaTier1:
					'''
					The full power of this blade has been sealed by an ancient knight...
					Defeat him to partially unlock its power!
					'''
				TerraprismaTier2:
					'''
					The full power of this blade has been sealed by the embodiment of chaos
					Defeat it to fully unlock its power!
					'''
				HerculesBeetle:
					'''
					{$CommonItemTooltip.Summon.TagStrength}
					{$CommonItemTooltip.Summon.CritChance@1}
					{$CommonItemTooltip.Summon.Knockback}
					'''
				NecromanticScroll:
					'''
					{$CommonItemTooltip.Summon.TagDuration}
					{$CommonItemTooltip.Summon.CritChance@1}
					'''
				PapyrusScarab:
					'''
					{$CommonItemTooltip.Summon.TagStrength}
					{$CommonItemTooltip.Summon.TagDuration}
					Tag boosts do not stack with downgrades
					{$CommonItemTooltip.Summon.CritChance@1}
					{$CommonItemTooltip.Summon.Knockback}
					'''
				FlinxFurChainedSetBonus: "{$CommonItemTooltip.IncreasesMaxMinionsBy}"
				AngelWings: "[c/ffbf00:You will discover these in time...]"
				AdamantiteDrill:
					'''
					[c/ffbf00:Use this to open the Adamantite gates in the]
					[c/ffbf00:Corruption Temple to the west of the village]
					'''
				BandOfRegeneration:
					'''
					Can be upgraded with the Band of Starpower 
					into the Mana Regeneration Band and then upgraded further with Dark Souls
					'''
				BandOfStarpower:
					'''
					Can be upgraded with the Band of Regeneration
					into the Mana Regeneration Band and then upgraded further with Dark Souls
					'''
				CobaltDrill:
					'''
					[c/ffbf00:Use this to gain entry to the Wyvern Mage's]
					[c/ffbf00:Fortress above the hallowed caverns to the East]
					'''
				DivingHelmet: Can be placed in an accessory slot or in your head slot.
				MechanicalWorm:
					'''
					It's heavier than you expected
					You get the feeling a way to stay in the air may be key...
					{$CommonItemTooltip.NonConsumable}
					'''
				MoltenPickaxe:
					'''
					[c/ffbf00:Can be used to open gates made of Cobalt Ore]
					Miakoda reminds you of the Cobalt Gate to the East of Obsidian's Volcano
					'''
				StickyBomb: More fun to use than a pickaxe!
				WormFood: "{$CommonItemTooltip.NonConsumable}"
				CopperAxe: All axes do 2x damage to woody enemies
				Diamond: Vital ingredient in the crafting of a very powerful potion
				IronOre: Perhaps you can use these for making special arrows..?
				RecallItem: "{$CommonItemTooltip.UnusableDuringBoss}"
				LargeAmethyst: "[c/ffbf00:A symbol resembling a large pyramid with the moon to its right side is carved into it]"
				LargeSapphire: "[c/ffbf00:A symbol resembling a snow-capped mountain near a fortress is carved into it]"
				RemixLargeSapphire:
					'''
					[c/ffbf00:Two symbols are carved into it: one resembling a dark-capped mountain near a fortress,]
					[c/ffbf00:and the other resembling a giant skull guarding the entrance to great corridors in the frozen depths]
					'''
				LargeRuby: "[c/ffbf00:A symbol resembling a ancient jungle temple accessible via a large pyramid is carved into it]"
				RemixLargeRuby:
					'''
					[c/ffbf00:A symbol resembling a ancient temple accessible via the depths of the jungle is carved into it]
					[c/ffbf00:Quite hidden, but you can also notice another symbol, that of a warm ocean with a coral reef in its depths]
					'''
				RemixLargeEmerald:
					'''
					[c/ffbf00:Two symbols are carved into it: one resembling lush underground jungle near a temple of meteorite,]
					[c/ffbf00:and the other resembling a warm ocean with a coral reef in its depths]
					'''
				LargeAmber: "[c/ffbf00:A symbol resembling the entrance to an abandoned temple under a hill is carved into it]"
				RemixLargeDiamond: "[c/ffbf00:A symbol resembling the entrance to an abandoned temple under a hill is carved into it]"
				VulnerabilityHex: Deals more damage and applies a vulnerability hex if Hellkite Dragon has been defeated
				IncinerationHex: Deals more damage and applies a incineration hex if Hellkite Dragon has been defeated
				MartianBuff: Deals more damage and electrocutes enemies if the Martians have been defeated
				StarinaBottle: Increases mana regen by 10 and decreases mana regen delay by 50%
				ManaRegenerationBand: Increases mana regen by 30 and decreases mana regen delay by 100%
				WellFedItemsBotC: Increases stamina regen by {0}% for the [c/6d8827:Bearer of the Curse]
				CeruleanManaRegenerationPotion: Increases Cerulean Flask restoration time by {0}%
				CelestialMagnetBotC: Mana Star pickups only restore {0}% of the [c/6d8827:Bearer of the Curse's] maximum mana
				MagicCuffsBotC: Only restores {0}% of pre-mitigation damage taken by the [c/6d8827:Bearer of the Curse] as mana
				CoinGun:
					'''
					[c/ffbf00:Can also use soul coins as ammo]
					[c/ffbf00:Soul coins pierce once]
					'''
			}

