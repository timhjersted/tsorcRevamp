		Configs: {
			01Gameplay.DisplayName: Gameplay
			02Visuals.DisplayName: Visuals
			03Sound.DisplayName: Sound
			04Controls.DisplayName: Controls

			tsorcRevampGameplayConfig: {
				DisplayName: Gameplay

				Headers: {
					AdventureMode: Adventure Mode
					GameplayChanges: Gameplay Changes
					GameplayTweaks: Gameplay Tweaks
				}

				AdventureMode: {
					Label: Adventure Mode: Main
					Tooltip:
						'''
						Prevents breaking and placing most blocks.
						It also enables some features intended for the custom map.
						"If the game lets you break it or place it, it's allowed!"
						Leave this enabled if you're playing with the custom map!
						'''
				}

				SoulsDropOnDeath: {
					Label: Souls Drop On Death
					Tooltip:
						'''
						Drop all your Dark Souls when you die.
						If "Delete Dropped Souls on Death" is enabled,
						your Souls will drop after old Souls are deleted.
						Does not take effect in multiplayer.
						Defaults to On
						'''
				}

				DeleteDroppedSoulsOnDeath: {
					Label: Delete Dropped Souls On Death
					Tooltip:
						'''
						Dark Souls dropped by dying will be deleted if you die again
						before picking them up. Even if this option is disabled, your
						Souls will be deleted if you exit the game while your Souls
						are still on the ground. Does not take effect in multiplayer.
						Defaults to On
						'''
				}

				BossZenConfig: {
					Label: Boss Zen Config
					Tooltip:
						'''
						Boss Zen disables enemy spawns while a boss is alive.
						Defaults to On
						'''
				}

				SoulsModeMobilityLimit: {
					Label: Souls Mode Mobility Limit
					Tooltip: Limits extreme running and flight speed while Unkindled or Bearer of the Curse. Classic mode is unaffected. Defaults to On.
				}

				ActiveShieldsRevamp: {
					Label: Active Shields Revamp
					Tooltip:
						'''
						Reworks shields into Dark Souls-style active blocking: hold Right Click (with a shield equipped and a weapon that has no right-click function) to raise it and fully block frontal hits at the cost of stamina (or mana, for magic wards).
						Only functions while Unkindled or Bearer of the Curse. Turn off to keep the classic passive shield behavior. Defaults to On.
						'''
				}

				NewSoulsModeStaminaSystem: {
					Label: Experimental Stamina Values
					Tooltip:
						'''
						Replaces the standard Souls Mode stamina numbers with a more demanding experimental set.
						Unkindled pays 1x weapon stamina cost and regenerates at 1.5x. Bearer of the Curse pays 1.5x and regenerates at 3x.
						By default (off) Unkindled pays 0.85x and regenerates at 1.25x, while Bearer of the Curse pays 1.15x and regenerates at 2x. Defaults to Off.
						'''
				}

				DebugMode: {
					Label: Debug Mode
					Tooltip: ""
				}

				DisableGloveAutoswing: {
					Label: Disable Melee/Whip Glove's Autoswing
					Tooltip:
						'''
						Disable the Melee/Whip Autoswing feature provided by the Feral Claws and it's upgrades,
						the Autofire option overrides this. Useful for whip stacking. Defaults to Off.
						'''
				}

				DisableAutomaticQuickMana: {
					Label: Disable Automatic Mana Potion drinking
					Tooltip:
						'''
						Disable the automatic quick mana feature provided by the Mana Flower and it's upgrades,
						useful for not accidentally drinking the Cerulean Flask in BotC-mode. Defaults to Off.
						'''
				}

				DisableRifleScopeZoom: {
					Label: Disable Rifle Scope Zoom
					Tooltip:
						'''
						Disable the Off-Screen Zooming feature provided by the Rifle Scope and it's upgrades,
						doesn't affect weapons like the Sniper Rifle which have this natively,
						useful for guns that have a right-click function. Defaults to Off.
						'''
				}

				DisableDragoonGreavesDoubleJump: {
					Label: Disable Dragoon Greaves Double Jump
					Tooltip: Disable the extra jump provided by both Dragoon Greaves. Defaults to Off.
				}

				DisableSupersonicWings2ExtraJumps: {
					Label: Disable Supersonic Wings II Extra Jumps
					Tooltip: Disable the extra jumps provided by the Supersonic Wings II. Defaults to Off.
				}

				DisableModWingsFallControlDuringFlight: {
					Label: Disable Mod Wings Fall Control During Flight
					Tooltip: ""
				}
			}

			tsorcRevampVisualConfig: {
				DisplayName: Visuals

				Headers: {
					Soapstones: Soapstones
					UI: UI
					Other: Other
				}

				DisableSoapstones: {
					Label: Disable Soapstones
					Tooltip: Only takes effect when creating new map
				}

				HideSoapstones: {
					Label: Hide Read Soapstones
					Tooltip:
						'''
						If enabled, soapstone messages that have been read will
						not be shown until a button is clicked to show them.
						Defaults to on.
						'''
				}

				AutoOpenSoapstones: {
					Label: Auto Open Soapstones
					Tooltip: ""
				}

				DisableStorySoapstones: {
					Label: Disable Story Soapstones
					Tooltip: ""
				}

				DisableLoreSoapstones: {
					Label: Disable Lore Soapstones
					Tooltip: ""
				}

				DisableTutorialSoapstones: {
					Label: Disable Tutorial Soapstones
					Tooltip: ""
				}

				SoapstoneScale: {
					Label: Soapstone Size Increase
					Tooltip:
						'''
						Increases the size of all soapstone dialogue boxes by a percentage.
						Defaults to 0%.
						'''
				}

				UseCustomResourceBars: {
					Label: Use Custom Resource Bars
					Tooltip: Adds custom health, mana, and stamina bars in the upper right corner. Turn off to use vanilla options.
				}

				HideOverheadStaminaBar: {
					Label: Hide Overhead Stamina Bar
					Tooltip: ""
				}

				EnemyHealthBars: {
					Label: Enemy Health Bars
					Tooltip: Show vanilla health bars below non-boss enemies. Defaults to Off.
				}

				AccuracyCombatText: {
					Label: Accuracy Combat Text
					Tooltip:
						'''
						Show floating text when Bearer of the Curse's ranged accuracy crosses into a new 10% band.
						Your exact accuracy is always readable on the Accuracy buff regardless of this setting. Defaults to On.
						'''
				}

				PlayerHurtVisuals: {
					Label: Player Hurt Visuals
					Tooltip:
						'''
						Shows a subtle pulsing red vignette around the screen edges when you take damage.
						Its brightness and intensity scale with how hard you were hit and how low your health is.
						Defaults to On.
						'''
				}

				HideCeruleanFlask: {
					Label: Hide the Cerulean Flask
					Tooltip:
						'''
						Hide the Cerulean Flask obtained in Bearer of the Curse mode,
						if you don't use it. Defaults to Off.
						'''
				}

				ChargeCircleOpacity: {
					Label: Charged Weapon Indicator Opacity
					Tooltip:
						'''
						Some charged weapons draw a circle around the cursor to indicate the
						current charge level. The opacity of that circle can be set here.
						Set to 0 to disable charge circles.
						'''
				}

				DisableLocationBanner: {
					Label: Disable Location Banner
					Tooltip: ""
				}

				OnlyShowMapWhenInventoryIsOpen: {
					Label: Only Show Map When Inventory Is Open
					Tooltip:
						'''
						Hides the minimap and overlay map during normal gameplay, while keeping your
						selected map mode visible when the inventory is open. Defaults to Off.
						'''
				}

				TransparentInventoryBar: {
					Label: Transparent Inventory Bar
					Tooltip:
						'''
						Keeps the selected hotbar slot visible, its neighbors at 50% opacity, and all remaining slots at 25%.
						Also hides the selected item name while the inventory is closed. Defaults to Off.
						'''
				}

				ShowStaminaTooltip: {
					Label: Show Stamina Use Tooltip
					Tooltip:
						'''
						Show the stamina consumption tooltip for Bearer of the Curse mode.
						Defaults to On.
						'''
				}

				SoulCounterPosX: {
					Label: Soul Counter X Position
					Tooltip: The X position of the Soul Counter.
				}

				SoulCounterPosY: {
					Label: Soul Counter Y Position
					Tooltip: The Y Position of the Soul Counter.
				}

				EstusFlaskPosX: {
					Label: Estus Flask X Position
					Tooltip: The X position of the Estus Flask.
				}

				EstusFlaskPosY: {
					Label: Estus Flask Y Position
					Tooltip: The Y position of the Estus Flask.
				}

				CeruleanFlaskPosX: {
					Label: Cerulean Flask X Position
					Tooltip: The X position of the Cerulean Flask.
				}

				CeruleanFlaskPosY: {
					Label: Cerulean Flask Y Position
					Tooltip: The Y position of the Cerulean Flask.
				}

				GravityFix: {
					Label: Gravitation No Longer Flips Screen
					Tooltip:
						'''
						Flipping gravity will only flip your character instead of the whole screen.
						WARNING! Some parts of the mod rely on this, and will be very disorienting otherwise
						Only disable if it is hard-incompatible with another mod
						'''
				}
			}

			tsorcRevampSoundConfig: {
				DisplayName: Sound

				UseOriginalPlayerHurtSounds: {
					Label: Use Original Player Hurt/Death Sounds
					Tooltip:
						'''
						Use the vanilla Terraria player hurt and death sounds.
						If disabled, custom Dark Souls hurt and death voices will be used.
						Defaults to Off.
						'''
				}

				MiakodaVolume: {
					Label: Miakoda Volume
					Tooltip:
						'''
						Revamp Miakoda giving you Navi flashbacks?
						This slider controls Miakoda's volume.
						Set to 0 to disable Miakoda sounds.
						'''
				}

				BonfireFlyVolume: {
					Label: Bonfirefly Volume
					Tooltip:
						'''
						Bonfirefly teasing you about a Bonfire which you can't reach yet?
						This slider controls Bonfirefly's volume.
						Set to 0 to disable Bonfirefly sounds.
						'''
				}

				BotCMechanicsVolume: {
					Label: Bearer of the Curse Class Mechanics Volume
					Tooltip:
						'''
						Are the new Curse Bearer mechanics too loud or simply annoying?
						This slider controls their volume.
						Set to 0 to disable them.
						'''
				}
			}

			tsorcRevampControlsConfig: {
				DisplayName: Controls

				AdvancedFourAttackWeaponControls: {
					Label: Advanced 4-Attack Weapon Controls
					Tooltip:
						'''
						Weapons with 4 attacks use left click/hold and right click/hold when Off.
						Turn On to map all 4 attacks to left click/hold, with 2 attacks mapped above
						and 2 attacks below a cursor threshold 3 tiles below your feet.
						This allows equipping two 4-attack weapons at once. Defaults to Off.
						'''
				}

				RecommendedControls: {
					Label: Recommended Controls
					Tooltip:
						'''
						Applies TSORC's recommended keyboard controls. Defaults to Off.
						On first load, only Dodge Roll and Auto Select are updated, and only when
						Dodge Roll is still using its current or old default key.
						Turning this on manually applies the full preset:
						Quick Heal / Estus Flask: R
						Quick Mana / Cerulean Tear: F
						Inventory: Q
						Dodge Roll: Left Shift
						Auto Select: Left Alt
						Quick Mount: G
						2nd Slot: Right Click
						'''
				}
			}
		}

