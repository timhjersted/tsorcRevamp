			}

			SlayerPinwheel: {
				FriendlyName: Family
				Description: Defeat Pinwheel, the necromancer cursing the caves below the village.
			}

			SlayerAncientOolacileDemon: {
				FriendlyName: Beast of the Lost Forest
				Description: Defeat the Ancient Oolacile Demon, the hidden beast of the Oolacile Forest.
			}

			SlayerSlograGaibon: {
				FriendlyName: Fallen Duo
				Description: Defeat Slogra and Gaibon, the undead and the demon refugees in their volcanic crypt.
			}

			SlayerJungleWyvern: {
				FriendlyName: Keeper of the Ruins
				Description: Defeat the Ancient Jungle Wyvern, the guardian of the Forgotten City.
			}

			SlayerDefiledDemon: {
				FriendlyName: Scourge of the City
				Description: Defeat the Defiled Demon of the Forgotten City, a powerful creature coming from the Underworld.
			}

			SlayerRage: {
				FriendlyName: Renaissance
				Description: Defeat the Rage, the phoenix of fire and wrath in the hallowed depths.
			}

			SlayerWyvernMage: {
				FriendlyName: Wyvern Tamer
				Description: Defeat the Wyvern Mage and his disciple in their fortress dominating the eastern mountains.
			}

			SlayerSorrow: {
				FriendlyName: Frozen Grief
				Description: Defeat the Sorrow, the water eagle lurking in the depths of icy waters.
			}

			SlayerHeroOfLumelia: {
				FriendlyName: Heroic Revenge
				Description: Defeat the Hero of Lumelia, coming to avenge his brother and your irresponsible actions against the world.
			}

			SlayerSerris: {
				FriendlyName: Battle X
				Description: Defeat Serris, an unknown being from space hidden under a dark tower.
			}

			SlayerDeath: {
				FriendlyName: Fate
				Description: Defeat Death.
			}

			SlayerAbsoluteDeath: {
				FriendlyName: Absolute Fate
				Description: Defeat Death at his full power during the Blood Moon.
			}

			ExploreShamanElderHome: {
				FriendlyName: Home of the Elder
				Description: Find the true home of the Shaman Elder at the edge of the world.
			}

			SlayerHunter: {
				FriendlyName: Hunting Time
				Description: Defeat the Hunter, the ferocious great vulture of the desert, the strongest of the Three Wings.
			}

			ExploreWifeRescured: {
				FriendlyName: The Reunion
				Description: Find Asha in a prison located deep within the ruins of the desert.
			}

			SlayerMachine: {
				FriendlyName: Flooded Gears
				Description: Defeat the Machine, the ancient keeper of the forgotten Machine Temple.
			}

			SlayerTriad: {
				FriendlyName: Triple Attack
				Description: Defeat the Triad, the eyes of death constantly observing the world from their giant shrine of glass.
			}

			SlayerAttraidies: {
				FriendlyName: The End?
				Description: Defeat Attraidies, the supreme warlock, bane of the world.
			}

			ExplorerSHM: {
				FriendlyName: Beyond Hard!
				Description: Opening a portal from the abyss by killing Attraidies, unleashing more dark and oppressive forces across the world.
			}

			SlayerHellkiteDragon: {
				FriendlyName: Dragon Slayer
				Description: Defeat the Hellkite Dragon, a fiery beast of the abyss roaming above the village.
			}

			SlayerKraken: {
				FriendlyName: Water Master
				Description: Defeat Water Fiend Kraken, the water god resting in fungal caverns.
			}

			SlayerLich: {
				FriendlyName: Earth Master
				Description: Defeat Earth Fiend Lich, the god of earth and necromancy, in his terrifying lair.
			}

			SlayerMarilith: {
				FriendlyName: Fire Master
				Description: Defeat Fire Fiend Marilith, the demonic fire goddess from the abyss.
			}

			SlayerWitchking: {
				FriendlyName: Bane of Humanity
				Description: Defeat the Witchking, a fallen king who has become a wraith wandering in the dark depths.
			}

			SlayerOccultist: {
				FriendlyName: Remnants of Oolacile
				Description: Defeat the Grand Occultist of Oolacile, a powerful sorcerer from the distant, ruined land of Oolacile.
			}

			SlayerArtorias: {
				FriendlyName: A Mighty Knight
				Description: Defeat Artorias, the great knight of Izalith, waiting in the ruins of the city.
			}

			SlayerBlight: {
				FriendlyName: ???
				Description: Defeat Blight, a strange entity from the abyss on the surface of the Frozen Ocean.
			}

			SlayerSeath: {
				FriendlyName: End of Immortality
				Description: Defeath Seath the Scaleless, the great undead dragon in search of immortality.
			}

			SlayerWyvernShadow: {
				FriendlyName: Dark Secrets
				Description: Defeat the Wyvern Mage Shadow and his phantom disciple, secretly imprisoned in a huge glass structure.
			}

			SlayerChaos: {
				FriendlyName: God of Discord
				Description: Defeat Chaos, the forgotten god of discord and darkness.
			}

			SlayerDarkCloud: {
				FriendlyName: Yourself
				Description: Defeat Dark Cloud.
			}

			SlayerGwyn: {
				FriendlyName: The First Flame
				Description: Defeat Gwyn.
			}
		}

		Bestiary: {
			DemonElemental: These primordial elementals are composed purely of demonic energy. They roam the Underworld with the sole purpose of fear and destruction.
			Dunlending: The Dunlendings are wild men from Dunland, a nearby land of vast plains. Their hatred of men and their savagery drive them to ravage the surrounding lands.
			DworcFleshhunter: A small, pigmy-like creature living in the jungle ruins, who ambushes strangers with his spear.
			DworcVenomsniper: A small, pigmy-like creature living in the jungle ruins, who secretly shoots darts at his enemies.
			DworcAlchemist: Although they appear barbaric, the dworcs have a strong sensitivity to magic and some become powerful sorcerers.
			DworcVoodooShaman: The emergence of powerful spirits in Terraria has strengthened the connection to the earth for some dworcs, allowing them to cast powerful elemental spells.
			DworcAbysswalker: Some dworcs are interested in dark magic, and the arrival of the abyss drives some to madness, spreading shadows in the depths of the jungle.
		}
	}
}

LegacyInterface.38: YOU DIED
