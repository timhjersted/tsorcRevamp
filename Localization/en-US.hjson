					{$CommonItemTooltip.LifeRegen}
					{$CommonItemTooltip.LifeThreshold@1}{$CommonItemTooltip.LifeRegen@2}
					'''
			}

			ManaShield: {
				DisplayName: Mana Shield
				Tooltip:
					'''
					Focuses the user's mana into a protective shield
					{$CommonItemTooltip.DRStat}, but drains {1} mana per hit
					Inhibits both natural and artificial mana regen after being hit({$CommonItemTooltip.SecondDuration@2})
					[c/ffbf00:Useful for those who do not specialize in magic]
					Reduces ranged, magic and summon damage by {3}% multiplicatively
					'''
			}

			MythrilGlove: {
				DisplayName: Mythril Glove
				Tooltip:
					'''
					Grants bonus defense and resistance based on health:
					Increase defense by 6 and resistance by 10 at all times
					Increase defense by 11 and resistance by 18 below 66% health
					Increase defense by 18 and resistance by 34 below 33% health
					'''
			}

			ProtectRing: {
				DisplayName: Protect Ring
				Tooltip:
					'''
					Ring that guards against death.
					Puts "Protect" on wearer ({$CommonItemTooltip.IncreasesDefenseBy})
					'''
			}

			RingOfClarity: {
				DisplayName: Ring of Clarity
				Tooltip:
					'''
					Immunity to {$CommonItemTooltip.OnFire}, Burning, Chilled, Frostburn, {$CommonItemTooltip.CursedInferno}, {$CommonItemTooltip.Ichor}, 
					Gravitation, Bleeding, Poisoned and knockback
					{$CommonItemTooltip.DRStat}
					{$CommonItemTooltip.LifeRegen@1}
					'''
