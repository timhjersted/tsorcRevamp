			Runeterra: {
				RuneMage: {
					DisplayName: Rune Mage
					Monologue1: What brings you here?
					Monologue2: I'm guarding something here. Don't go too far into this room.
					Monologue3: I appreciate the company, but I'm afraid you'll lose yourself if you stay here too long. You should get going.
					Warning1: Don't come any closer!
					Warning2: Turn back now!
					Warning3: This conflict is unnecessary. If you wish to live, stay away from the World Rune.
					Warning4: Even if you defeat me, you cannot possibly handle the power of the World Rune without losing yourself!
					Warning5: I'm sorry it had to come to this. I should've sent you away before the World Rune could tempt you.
					IdleOnHitWarning1: Hey! Watch it!
					IdleOnHitWarning2: Try that again and I'll consider you an enemy.
					IdleOnHitWarning3: You've made your intentions clear!
					AgitatedOnHitWarning1: Stop! Listen to me!
					AgitatedOnHitWarning2: I'm giving you one last chance to reconsider.
					AgitatedOnHitWarning3: I tried to warn you!
				}
			}
		}

