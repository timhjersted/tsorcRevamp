			Accuracy: {
				DisplayName: Accuracy
				Description:
					'''
					Every ranged shot that connects raises your accuracy by {0}%; every one that misses lowers it by {1}%.
					At full accuracy you gain {2}% critical strike chance and {3}% critical damage.
					Currently [c/deb887:{4}%] accuracy: [c/ea00ea:+{5}% crit chance, +{6}% crit damage]
					'''
				OldDarksignTooltip:
					'''
						[c/22dd96:Ranged critical strike chance is now dependant on your accuracy,]
						[c/22dd96:missing shots will decrease it, while hitting shots will increase it.]
						[c/22dd96:A ranged projectile only needs to hit once to count as hit, ]
						[c/22dd96:can't increase your accuracy multiple times and can also only miss once.]
						[c/22dd96:Homing projectiles can't increase your accuracy.]
						[c/22dd96:A hit will increase your accuracy by {0}%, while missing will decrease your accuracy by {1}%.]
						[c/22dd96:You can gain up to {2}% crit chance flat and a {3}x multiplier at 100% accuracy,]
						[c/22dd96: or have a {4}x multiplier to your total crit at 0% accuracy.]
					'''
			}

			Attunement: {
				DisplayName: Attunement
				Description:
					'''
					Landing magic hits grants a stack of Attunement (2 on a crit).
					Each stack reduces spell mana cost by {0}%, up to {1}% at {2} stacks.
					Stacks fall off one at a time if you stop landing hits.
					Currently {3}/{2} stacks: [c/ea00ea:-{4}% mana cost]
					'''
			}

