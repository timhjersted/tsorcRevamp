					{$CommonItemTooltip.NonConsumable}
					'''
				Summon: The Machine has awoken!
				Wrong: This item can only be used in The Flooded Machine Temple at night...
				WrongTime: This item can only be used at night...
			}

			DarkMirror: {
				DisplayName: Dark Mirror
				Tooltip: ""
				AdvMode:
					'''
					You look into the mirror and see your reflection looking back at you...
					As you continue to gaze into the mirror, the background behind
					your reflection comes into focus, revealing a dark pyramid...
					Use the mirror at night to continue looking into the eyes of your reflection...
					Or throw it away and rid yourself of this dark relic...
					'''
				RemixMode:
					'''
					You look into the mirror and see your reflection looking back at you...
					As you continue to gaze into the mirror, the background behind
					your reflection comes into focus, revealing the abyss...
					Use the mirror to continue looking into the eyes of your reflection...
					Or throw it away and rid yourself of this dark relic...
					'''
				NonAdv:
					'''
					You look into the mirror and see your reflection looking back at you...
					As you continue to gaze into the mirror, the background behind
					your reflection becomes murky, as if peering into a dark abyss...
					Use the mirror to continue looking into the eyes of your reflection...
					Or throw it away and rid yourself of this dark relic...
					'''
				Summon: Your shadow self has manifested from your darkest fears...
				Engulf: The mirror's shadow engulfs you...
			}

