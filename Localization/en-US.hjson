		World: {
			InitiateTheEnd:
				'''
				The portal from The Abyss has closed!
				The world has been healed. Attraidies' sway over the world has finally ended!
				'''
			FinalGuardian:
				'''
				You have vanquished the final guardian...
				The portal from The Abyss remains closed. All is at peace...
				'''
			TPToBonfire: Teleport to Bonfire Checkpoint
			NoTPCombat: Can not teleport while in combat!
			NoTPBoss: Can not teleport while a boss is alive!
			AbyssalFissure: Abyssal Fissure
			DropSouls1: "Dropping "
			DropsSouls2: souls
			MonolithLocked:
				'''
				The power of this monolith is bound to Attraidies
				Defeating him and returning here may allow you to release it...
				'''
		}

		DropRules: {
			SHMOnly: "[c/ff9999:Only drops in Super Hardmode]"
			NonSHMOnly: "[c/99ccff:Does not drop in Super Hardmode]"
			NonSHMFirstKill: "[c/99ccff:Guaranteed on the first kill (not in Super Hardmode)]"
			NonSHMRepeatKill: "[c/99ccff:Repeat kills after the first (not in Super Hardmode)]"
			AbyssOnly: "[c/ff9999: Only drops while The Covenant of Artorias is equipped]"
			FirstBagOnly: "[c/ff9999: Only drops from the first opened specific Bag]"
			BotCOnly: "[c/ff9999: Only drops when the player is Unkindled or a Bearer of the Curse]"
			FirstBagBotCOnly: "[c/ff9999: Only drops from the first opened specific Bag while the player is Unkindled or a Bearer of the Curse]"
			AdvModeOnly: "[c/ff9999:Only drops in Adventure Mode]"
			SandboxModeOnly: "[c/ff9999:Only drops outside of Adventure Mode]"
			FirstBossKill: "[c/ff9999: Only drops on the first kill]"
			NonExpertFirstKill: "[c/ff9999: Only drops on the first kill outside of Expert Mode]"
			DownedSkeletron: "[c/ff9999: Drops after defeating Skeletron]"
		}

