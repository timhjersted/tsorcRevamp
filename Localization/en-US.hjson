					{$CommonItemTooltip.Magic.ManaRegen@2}
					{$CommonItemTooltip.Magic.ManaRegenDelay@3}
					'''
			}

			BarrierRing: {
				DisplayName: Barrier Ring
				Tooltip:
					'''
					Casts a Barrier around the wearer which will block an attack
					After blocking an attack it will go on a {$CommonItemTooltip.Cooldown}
					Cooldown only refreshes while wearing this
					'''
			}

			BloodbiteRing: {
				DisplayName: Bloodbite Ring
				Tooltip:
					'''
					One of the infamous bite rings commissioned by Sir Arstor of Carim
					Despite the dreadful rumors surrounding its creation, this ring
					is an unmistakable asset, due to its ability to prevent bleeding.
					'''
			}

			BlueTearstoneRing: {
				DisplayName: Blue Tearstone Ring
				Tooltip:
					'''
					The rare gem called tearstone has the uncanny ability to sense imminent death.
					{$CommonItemTooltip.LifeThreshold}{$CommonItemTooltip.IncreasesDefenseBy@1} and
					{$CommonItemTooltip.DRStat@2}
					'''
			}

			Celestriad: {
				DisplayName: Celestriad
				Tooltip:
					'''
					[c/ffbf00:Focuses the user's mana into a protective shield]
					{$CommonItemTooltip.DRStat}, but drains {1} mana per hit
					[c/00ffd4:{$CommonItemTooltip.IncreasesMaxManaBy@2}]
					Inhibits both natural and artificial mana regen after being hit({$CommonItemTooltip.SecondDuration@3})
					Reduces ranged, magic and summon damage by {4}% multiplicatively
					'''
			}

			CovenantOfArtorias: {
				DisplayName: Covenant of Artorias
				Tooltip:
					'''
					{$CommonItemTooltip.VanityFunction}
					[c/ffbf00:Allows you to safely enter The Abyss when worn. Remove the ring to escape from The Abyss!]
					[c/ffbf00:The Abyss pervades the entire world, like a mirror of our own, but dangerous foes are far more numerous in this realm.]
					'''
			}

			DarkCloak: {
				DisplayName: Dark Cloak
				Tooltip: "[c/ffbf00:{$CommonItemTooltip.LifeThreshold}{$CommonItemTooltip.IncreasesDefenseBy@1}]"
			}

			GreyWolfRing: {
				DisplayName: Grey Wolf Ring
				Tooltip:
					'''
					A great ring, resonating with the abyss, which gives you a will of steel.
					Inherits {$Items.RingOfClarity.DisplayName} and {$Items.WolfRing.DisplayName} immunities
					Press Wolf Ring to massively increase life regen and damage taken temporarily
					Removes the life regen if hit during the effect and puts it on a long cooldown
					{$CommonItemTooltip.IncreasesDefenseBy} within the Abyss
					{$CommonItemTooltip.DRStat@1}
					{$CommonItemTooltip.LifeRegen@2}
					{$CommonItemTooltip.IncreasesMaxLifeByPercent@3}
					'''
			}

			IronShield: {
				DisplayName: Iron Shield
				Tooltip:
					'''
					{$CommonItemTooltip.DRStat}
					{$CommonItemTooltip.BadMoveSpeedMult@1}
