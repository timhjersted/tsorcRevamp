				DisplayName: Aura of Decay
				Tooltip: You periodically release a damaging wave of poison
			}

			AuraOfIlluminance: {
				DisplayName: Aura of Illuminance
				Tooltip: Creates a glowing trail behind you
			}

			ConditionOverload: {
				DisplayName: Condition Overload
				Tooltip:
					'''
					Enemies take 7% bonus damage for every debuff affecting them.
					"H Deimos CO farm 3/4 LF despoil"
					Debuffs inflicted by whips excluded.
					'''
			}

			CosmicWatch: {
				DisplayName: Cosmic Watch
				Tooltip:
					'''
					Use this item to push time foward
					to the beginning of night or to the beginning of day
					'''
				Day: You shift time forward and a new day begins...
				Night: You shift time forward and a new night begins...
			}

			ShadowmoonCloak: {
				DisplayName: Shadowmoon Cloak
				Tooltip:
					'''
					Inherits the Star Cloaks effect and grants {$CommonItemTooltip.PercentIncreasedDamageCritChance}
					Magic Imbues no longer need to go on cooldown
					{$CommonItemTooltip.LifeThreshold@1}{$CommonItemTooltip.Magic.ManaRegen@2} and grants an additional
					{$CommonItemTooltip.PercentIncreasedDamageCritChance@3}
					'''
			}

			AncientDemonShield: {
