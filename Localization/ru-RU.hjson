		Configs: {
			tsorcRevampConfig: {
				DisplayName: Конфиг

				AdventureMode: {
					Label: Режим приключений: Основной
					Tooltip:
						'''
						Запрещает разрушение и размещение большинства блоков. 
						Это также позволяет использовать некоторые функции, предназначенные для пользовательской карты. 
						"Если игра позволяет вам ломать или размещать блоки, это разрешено!"
						Оставьте этот параметр включённым, если вы играете с пользовательской картой!
						'''
				}

				SoulsDropOnDeath: {
					Label: Выпадение душ при смерти
					Tooltip:
						'''
						После смерти вы теряете все свои тёмные души.
						Если включена функция "Удалять выпавшие души после смерти", 
						Ваши души будут выпадать после удаления старых душ
						Не даёт эффекта в пультиплеере.
						По умолчанию включено
						'''
				}

				DeleteDroppedSoulsOnDeath: {
					Label: Удалить выпавшие души при смерти
					Tooltip:
						'''
						Тёмные души, выпавшие при смерти, будут удалены, если вы умрёте ещё раз, 
						прежде чем забрать их.  Даже если эта опция отключена, ваши 
						души будут удалены, если вы выйдете из игры,
						если они всё еще находятся в воздухе. Не действует в мультиплеере.
						По умолчанию включено
						'''
				}

				BossZenConfig: {
					Label: Конфиг дзена босса
					Tooltip:
						'''
						Дзен босса отключает появление врагов, пока босс жив.
						По умолчанию включено
						'''
				}

				DisableGloveAutoswing: {
					Label: Отключает автоматическую атаку хлыстов/ближнего боя
					Tooltip:
						'''
						Отключите автоматическую атаку хлыстов/оржия ближнего боя, предоставляемую звериными когтями и её усилениями,
						опция автоматического ведения огня отменяет это. Полезно для складывания хлыстов. По умолчанию отключено.
						'''
				}

				DisableAutomaticQuickMana: {
					Label: Отключить автоматическое выпивание зелья маны
					Tooltip:
						'''
						Отключает функцию автоматического применения зелья маны, предоставляемую цветком маны и его улучшениями,
						которая полезна для того, чтобы случайно не выпить лазурную колбу в режиме Носителя проклятия. По умолчанию отключено.
						'''
				}

				DisableRifleScopeZoom: {
					Label: Отключить масшатбирование снайперского прицела
					Tooltip:
						'''
						Отключает функцию масштабирования пределов экрана, предоставляемую прицелом винтовки и её улучшениями.
						Не влияет на оружия, такие как снайперская винтовка, у которой функция есть изначально.
						Это полезно для оружия, у которого есть какая-либо функция при нажатии ПКМ. По умолчанию отключено.
						'''
				}

				DisableDragoonGreavesDoubleJump: {
					Label: Отключение двойного прыжка Драгунских поножей
					Tooltip: Отключает дополнительный прыжок, обеспечиваемый обоими драгунскими поножами. По умолчанию выключено.
				}

				DisableSupersonicWings2ExtraJumps: {
					Label: Отключает дополнительный прыжок сверхзвуковых крыльев II
					Tooltip: Отключает дополнительные прыжки, предоставляемые сверхзвуковыми крыльями II. По умолчанию отключено.
				}

				SoulCounterPosX: {
					Label: Позиция счётчика душ по X
					Tooltip: Положение счётчика душ по оси X.
				}

				SoulCounterPosY: {
					Label: Позиция счётчика душ по Y
					Tooltip: Положение счётчика душ по оси Y.
				}

				EstusFlaskPosX: {
					Label: Позиция фляги эстуса по X
					Tooltip: Положение фляги эстуса по оси X
				}

				EstusFlaskPosY: {
					Label: Позиция фляги эстуса по Y
					Tooltip: Положение фляги эстуса по оси Y
				}

				CeruleanFlaskPosX: {
					Label: Позиция лазурной фляги по X
					Tooltip: Положение Лазурной фляги по оси X
				}

				CeruleanFlaskPosY: {
					Label: Позиция лазурной фляги по Y
					Tooltip: Положение Лазурной фляги по оси Y
				}

				HideCeruleanFlask: {
					Label: Скрыть лазурную флягу
					Tooltip:
						'''
						Скрывает лазурную колбу, полученную в режиме носителя проклятия,
						если вы её не используете. По умолчанию отключено.
						'''
				}

				ChargeCircleOpacity: {
					Label: Непрозрачность индикатора заряда оружия
					Tooltip:
						'''
						Для некоторых видов заряженного оружия курсор обводится кругом,
						чтобы указать текущий уровень заряда. Непрозрачность этого круга можно настроить здесь.
						Установите значение 0, чтобы отключить круг заряда.
						'''
				}

				HideSoapstones: {
					Label: Скрыть прочитанные белые знаки
					Tooltip:
						'''
						Если эта опция включена, прочитанные сообщения белых знаков
						не будут отображаться до тех пор, пока не будет нажата кнопка для их отображения.
						По умолчанию включено.
						'''
				}

				SoapstoneScale: {
					Label: Увеличение размера белого знака
					Tooltip:
						'''
						Увеличивает размер всех диалоговых окон белых знаков на определённый процент.
						По умолчанию 0%.
						'''
				}

				ShowStaminaTooltip: {
					Label: Отобразить всплывающую подсказку по использованию выносливости
					Tooltip:
						'''
						Отобразить всплывающую подсказку по потреблению выносливости для режима носителя проклятия.
						По умолчанию 0%.
						'''
				}

				GravityFix: {
					Label: Зелье гравитации не переворачивает экран
					Tooltip:
						'''
						Переключение гравитации приведёт только к переворачиванию вашего персонажа, а не всего экрана целиком.
						ОСТОРОЖНО! Некоторые части мода основаны на этом, и в противном случае будут сильно сбивать с толку
						Отключайте только в том случае, если оно несовместим с другим модом
						'''
				}

				BroadswordRework: {
					Label: Доработка мечей
					Tooltip:
						'''
						В БЕТЕ! 
						делает мечи великолепными. 
						Для достижения эффекта требуется перезагрузка мира.
						'''
				}

				MiakodaVolume: {
					Label: Громкость Миакоды
					Tooltip:
						'''
						Изменить громкость Миакоды, чтобы у вас не возникало воспоминаний о Нави?
						Этот ползунок регулирует громкость Миакоды.
						Установите 0, чтобы отключить звуки Миакоды.
						'''
				}

				BonfireFlyVolume: {
					Label: Громкость светлячков у костра
					Tooltip:
						'''
						Светлячок дразнит вас из-за костра, до которого вы ещё не можете добраться?
						Этот ползунок регулирует громкость светлячков.
						Установите 0, чтобы отключить звуки светлячков.
						'''
				}

				BotCMechanicsVolume: {
					Label: Громкость механики носителя проклятия
					Tooltip:
						'''
						Новая механика "носитель проклятия" слишком громкая или просто раздражает?
						Этот ползунок регулирует её громкость
						Установите 0, чтобы отключить звуки.
						'''
				}

