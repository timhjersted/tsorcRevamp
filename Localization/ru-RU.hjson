					'''
			}

			StoneOfSeath: {
				DisplayName: Камень Сита
				Tooltip:
					'''
					Призывает Нагого сита, великого дракона, которому лорд Гвин даровал титул герцога за 
					помощь в победе над драконами Вечности и даровал частицу Души Лорда. Сит 
					сошел с ума во время своих исследований Чешуи Бессмертия, которую он так и не смог 
					получить. По иронии судьбы, теперь он сам стал бессмертным, настоящей Нежитью благодаря своим исследованиям 
					Изначального кристалла, который он украл у драконов, когда дезертировал.
					'''
				Summon: "Твоя смерть только подпитает мое бессмертие, Рэд... "
			}

			MasterRing: {
