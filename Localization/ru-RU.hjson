			AbyssScroll: {
				DisplayName: Свиток бездны
				Tooltip:
					'''
					Чтобы закрыть печать Бездны, вам необходимо победить 6 повелителей Бездны:
					Арториас, Мор, Маг теневой виверны, нагой Сит и Хаос.
					Имея душу лорда от каждого из этих существ, вы сможете призвать последнего лорда: Гвина, Повелителя Пепла.
					Чтобы создать призывной предмет для каждого лорда, вам нужно будет вернуться в восемь знакомых мест
					и собрать уникальный предмет, выпавший из врага, которого вы там встретите: Западный океан, Подземелье,
					Порча, Джунгли, Подземелье, Преисподняя и Восточный океан.
					'''
			}

			AngerTalisman: {
				DisplayName: Талисман гнева
				Tooltip:
					'''
					{$CommonItemTooltip.PercentIncreasedDamage}
					{$CommonItemTooltip.BadDefense@1}
					'''
			}

			AuraOfDecay: {
				DisplayName: Аура разложения
				Tooltip: Вы периодически выпускаете разрушительную волну яда
			}

			AuraOfIlluminance: {
				DisplayName: Аура озарения
				Tooltip: Создаёт светящийся след позади вас
			}

			ConditionOverload: {
				DisplayName: Состояние перегрузки
				Tooltip:
					'''
					Враги получают дополнительный урон за каждый действующий на них дебафф.
					"3/4 часть фермы компании Деймоса была ограблена"
					Дебаффы, наносимые хлыстом, исключены.
					'''
			}

			CosmicWatch: {
				DisplayName: Космические часы
				Tooltip:
					'''
					Используйте этот предмет, чтобы перевести время вперед
					к началу ночи или к началу дня
					'''
				Day: Вы переводите время вперед, и начинается новый день...
				Night: Вы переводите время вперед, и начинается новая ночь...
			}

			ShadowmoonCloak: {
				DisplayName: Плащ призрачной Луны
				Tooltip:
					'''
					Наследует эффект Звездных плащей и дарует {$CommonItemTooltip.PercentIncreasedDamageCritChance}
					Магические способности больше не требуют перезарядки.
					{$CommonItemTooltip.LifeThreshold@1}{$CommonItemTooltip.Magic.ManaRegen@2} и дополнительно даёт
					{$CommonItemTooltip.PercentIncreasedDamageCritChance@3}
					'''
			}

			AncientDemonShield: {
				DisplayName: Древний демонический щит
