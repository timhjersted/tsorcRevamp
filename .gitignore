# Standalone offline preview tools under .agents/tools are their own dotnet
# projects. The /bin and /obj rules above are root-anchored and miss nested
# projects, so their build output needs explicit rules or it gets committed.
.agents/tools/*/bin/
.agents/tools/*/obj/
